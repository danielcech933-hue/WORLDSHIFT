{
  "name": "roblox-forge",
  "version": "1.2.5",
  "private": true,
  "description": "ROBLOX FORGE desktop development platform, local bridge, MCP gateway, multi-agent orchestrator and extensible plugin host.",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node forge-server.mjs",
    "desktop": "electron .",
    "mcp": "node mcp-server.mjs",
    "agents": "node agents/orchestrator.mjs",
    "jarvis": "node jarvis-backend.mjs",
    "pc:scan": "node pc-inventory.mjs",
    "pc:plan": "node pc-optimizer.mjs",
    "verify": "node smoke-test.mjs",
    "desktop:dev": "electron .",
    "build:win": "electron-builder --win nsis portable"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.robloxforge.desktop",
    "productName": "ROBLOX FORGE",
    "directories": { "output": "dist" },
    "files": ["desktop/**/*", "forge-server.mjs", "jarvis-backend.mjs", "jarvis-system-tools.mjs", "model-router.mjs", "task-queue.mjs", "interrupt-controller.mjs", "pc-inventory.mjs", "pc-optimizer.mjs", "mcp-server.mjs", "agents/**/*", "plugins/**/*", "public/**/*", "smoke-test.mjs", "package.json", ".opencode/**/*", ".gemini/**/*"],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "ROBLOX-FORGE-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
